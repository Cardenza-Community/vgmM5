+static IRAM_ATTR __attribute__((always_inline, optimize("O3")))
+inline uint32_t apply_ym2612_clock_ratio(
+    const FMSoundEngine *engine,
+    uint32_t native_step
+) {
+    const uint32_t ratio =
+        engine->ym2612_clock_ratio_q16;
+
+    const uint32_t step_hi =
+        native_step >> 16;
+
+    const uint32_t step_lo =
+        native_step & 0xFFFFu;
+
+    uint32_t phase_advance =
+        step_hi * ratio;
+
+    phase_advance +=
+        (step_lo * ratio) >> 16;
+
+    return phase_advance;
+}
+
+static IRAM_ATTR __attribute__((always_inline, optimize("O3")))
+inline uint32_t calc_ym2612_fnum_pm_advance(
+    const FMSoundEngine *engine,
+    const OperatorState *op,
+    int32_t pm_amount
+) {
+    static const uint8_t fn_note_table[16] = {
+        0, 0, 0, 0,
+        0, 0, 0, 1,
+        2, 3, 3, 3,
+        3, 3, 3, 3
+    };
+
+    const uint32_t op_fn =
+        op->f_number & 0x7FFu;
+
+    const uint32_t op_blk =
+        op->block & 7u;
+
+    uint32_t note =
+        fn_note_table[(op_fn >> 7) & 0x0Fu];
+
+    uint32_t kc =
+        (op_blk << 2) | note;
+
+    if (kc > 31u) {
+        kc = 31u;
+    }
+
+    uint32_t base17;
+
+    if (op_blk == 0u) {
+        base17 = op_fn >> 1;
+    } else {
+        base17 = op_fn << (op_blk - 1u);
+    }
+
+    /*
+     * 現在の後掛けPMとほぼ同じ相対深度を、
+     * DT／MULより前のbase17へ適用する。
+     */
+    if (pm_amount != 0) {
+        int32_t pm_delta =
+            (((int32_t)(base17 >> 10)) *
+             pm_amount) >> 3;
+
+        int32_t modulated_base =
+            (int32_t)base17 + pm_delta;
+
+        if (modulated_base < 0) {
+            modulated_base = 0;
+        } else if (modulated_base > 0x1FFFF) {
+            modulated_base = 0x1FFFF;
+        }
+
+        base17 = (uint32_t)modulated_base;
+    }
+
+    const uint32_t dt =
+        (op->mul >> 4) & 7u;
+
+    const uint32_t dt_mag =
+        DT_TAB[dt & 3u][kc];
+
+    const int32_t signed_dt =
+        (dt & 4u)
+            ? -(int32_t)dt_mag
+            : (int32_t)dt_mag;
+
+    base17 =
+        (uint32_t)((int32_t)base17 + signed_dt)
+        & 0x1FFFFu;
+
+    const uint32_t mul =
+        op->mul & 0x0Fu;
+
+    uint32_t inc20;
+
+    if (mul == 0u) {
+        inc20 = base17 >> 1;
+    } else {
+        inc20 = base17 * mul;
     }
+
+    inc20 &= 0xFFFFFu;
+
+    return apply_ym2612_clock_ratio(
+        engine,
+        inc20 << 12
+    );
+}
+
+static IRAM_ATTR __attribute__((always_inline, optimize("O3")))
+inline uint32_t calc_ym2612_phase_advance(
+    const FMSoundEngine *engine,
+    const OperatorState *op,
+    int32_t pm_amount
+) {
+    uint32_t phase_advance =
+        apply_ym2612_clock_ratio(
+            engine,
+            op->phase_step
+        );
+
+    if (pm_amount != 0) {
+        phase_advance +=
+            (((int32_t)(phase_advance >> 10)) *
+             pm_amount) >> 3;
+    }
+
+    return phase_advance;
 }
 
